@{
    ViewData["Title"] = "Home Page";
}



@section Scripts{
    <script>
        // TODO: Écrire votre script
        $.get('/Home/Partielle',
        function (htmlData) {
            $("#contenuPartielle").html(htmlData);
        });
        function afficherPartielle() {
            let data = {
                qty: $("#nombre").val(),   // Remplacez x par le code qui permet d’aller chercher la valeur du input
                texte: $("#texte").val(),  // Idem
            };

            //console.log(data);

            $.get('/Home/Partielle2', data, 
            function (htmlData) {
                $("#contenuPartielle2").html(htmlData);
            });
        }
    </script>
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <!--Utiliser ce div pour afficher la 1ere vue partielle-->
    <div id="contenuPartielle"></div>


    <input type="text" id="texte" />
    <input type="number" id="nombre" />

    <button onclick="afficherPartielle()">Afficher</button>

    <!--Utiliser ce div pour afficher la 2e vue partielle-->
    <div id="contenuPartielle2"></div>
</div>





